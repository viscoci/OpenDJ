# ─── App origin ───────────────────────────────────────────────────────────────
# Use 127.0.0.1 (NOT `localhost`) — Spotify dropped `localhost` from accepted
# redirect URIs in 2024. See:
#   https://developer.spotify.com/documentation/web-api/concepts/redirect_uri
# Both 127.0.0.1 and [::1] are valid Spotify redirect targets and Chrome
# treats them as secure contexts, so `__Host-` session cookies still work.
# Whatever you pick here, ALWAYS access the app at the same origin so the
# session cookie and OAuth callback agree.
BASE_URL=http://127.0.0.1:8888

# ─── Spotify Developer credentials (https://developer.spotify.com/dashboard) ──
# Create an app, copy Client ID + Client secret here, and add the redirect URI
# below to the app's "Redirect URIs" allowlist EXACTLY (protocol, host, port,
# path must all match).
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8888/api/v1/provider/connections/spotify/callback

# ─── Database ─────────────────────────────────────────────────────────────────
# Defaults work with the bundled docker-compose Postgres.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/opendj

# ─── App tuning ───────────────────────────────────────────────────────────────
MAX_SONGS_PER_GUEST=3
# MAX_GUESTS_PER_SESSION leave blank for unlimited
MAX_GUESTS_PER_SESSION=
MODERATION_ENABLED_DEFAULT=false

# Frontend bundle path (relative to the process cwd). Defaults to the dev
# path when launched from the repo root. Build it with:
#   pnpm --filter @opendj/frontend-template build
# Leave unset to skip serving the frontend (API only).
# FRONTEND_DIST=packages/frontend-template/dist/opendj-template/browser

# Where to redirect after a successful OAuth login.
# POST_LOGIN_PATH=/

# Where to redirect after a successful music-provider OAuth callback.
# Defaults to /host/dashboard so the host lands back on their dashboard
# with the new connection visible.
# POST_PROVIDER_CALLBACK_PATH=/host/dashboard

# ─── OAuth login providers ────────────────────────────────────────────────────
# Sign-in identities. Each is optional — set the provider's CLIENT_ID +
# CLIENT_SECRET to enable. Redirect URI defaults to
#   ${BASE_URL}/api/v1/auth/oauth/<provider>/callback
# (which means it'll be 127.0.0.1, matching the BASE_URL above — register
# THAT exact URL with the provider, not localhost).
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=
# APPLE_CLIENT_ID=
# APPLE_CLIENT_SECRET=
# APPLE_REDIRECT_URI=
# FACEBOOK_CLIENT_ID=
# FACEBOOK_CLIENT_SECRET=
# FACEBOOK_REDIRECT_URI=

# ─── Optional ─────────────────────────────────────────────────────────────────
# Only needed when scaling OSS beyond one Node container.
# VALKEY_URL=redis://localhost:6379
