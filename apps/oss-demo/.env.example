# Spotify Developer Dashboard credentials (https://developer.spotify.com/dashboard)
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=http://localhost:8888/api/v1/provider/connections/spotify/callback

# Database — defaults work with the bundled docker-compose Postgres
DATABASE_URL=postgres://postgres:postgres@localhost:5432/opendj

# App
BASE_URL=http://localhost:8888
MAX_SONGS_PER_GUEST=3
# MAX_GUESTS_PER_SESSION leave blank for unlimited
MAX_GUESTS_PER_SESSION=
MODERATION_ENABLED_DEFAULT=false

# Frontend bundle path (relative to the process cwd). Defaults to the dev
# path when launched from the repo root. Build it with:
#   pnpm --filter @opendj/frontend-template build
# Leave unset to skip serving the frontend (API only).
# FRONTEND_DIST=packages/frontend-template/dist/opendj-template/browser

# Where to redirect after a successful OAuth login.
# POST_LOGIN_PATH=/

# Where to redirect after a successful music-provider OAuth callback.
# Defaults to /host/dashboard so the host lands back on their dashboard
# with the new connection visible.
# POST_PROVIDER_CALLBACK_PATH=/host/dashboard

# OAuth login providers (sign-in identities). Each is optional — set the
# provider's CLIENT_ID + CLIENT_SECRET to enable. Redirect URI defaults
# to ${BASE_URL}/api/v1/auth/oauth/<provider>/callback.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=
# APPLE_CLIENT_ID=
# APPLE_CLIENT_SECRET=
# APPLE_REDIRECT_URI=
# FACEBOOK_CLIENT_ID=
# FACEBOOK_CLIENT_SECRET=
# FACEBOOK_REDIRECT_URI=

# Optional: only needed when scaling OSS beyond one Node container
# VALKEY_URL=redis://localhost:6379
