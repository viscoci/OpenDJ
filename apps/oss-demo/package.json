{
  "name": "opendj-oss-demo",
  "version": "0.0.0",
  "private": true,
  "description": "OpenDJ self-host reference deploy. Node 22 + Postgres via Docker Compose.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "echo \"(oss-demo) lint placeholder\" && exit 0",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "echo \"(oss-demo) no tests yet\" && exit 0",
    "start": "tsx src/main.ts",
    "db:migrate": "pnpm --filter @opendj/db db:migrate"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.0",
    "@hono/node-ws": "^1.0.0",
    "@opendj/backend": "workspace:*",
    "@opendj/db": "workspace:*",
    "hono": "^4.12.32",
    "tsx": "^4.23.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0"
  }
}
