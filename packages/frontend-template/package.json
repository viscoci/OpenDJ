{
  "name": "@opendj/frontend-template",
  "version": "0.0.0",
  "private": true,
  "description": "Basic Angular 21 OSS frontend template for OpenDJ. Capacitor-ready, web-first.",
  "license": "MIT",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test --no-watch",
    "lint": "echo \"(frontend-template) lint not configured yet\" && exit 0",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "packageManager": "pnpm@9.15.4",
  "dependencies": {
    "@angular/common": "^21.2.18",
    "@angular/compiler": "^21.2.18",
    "@angular/core": "^21.2.18",
    "@angular/forms": "^21.2.18",
    "@angular/platform-browser": "^21.2.18",
    "@angular/router": "^21.2.18",
    "@capacitor/core": "^6.2.0",
    "@opendj/app-shell": "workspace:*",
    "@opendj/core": "workspace:*",
    "@opendj/frontend": "workspace:*",
    "@opendj/realtime": "workspace:*",
    "qrcode": "^1.5.4",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^21.2.19",
    "@angular/cli": "^21.2.19",
    "@angular/compiler-cli": "^21.2.18",
    "@capacitor/cli": "^6.2.0",
    "@types/qrcode": "^1.5.6",
    "jsdom": "^28.0.0",
    "prettier": "^3.9.5",
    "typescript": "~5.9.2",
    "vitest": "^4.0.8"
  }
}
