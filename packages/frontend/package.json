{
  "name": "@opendj/frontend",
  "version": "0.0.0",
  "description": "Reusable Angular components and services for the OpenDJ host + guest flows.",
  "license": "MIT",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    }
  },
  "files": [
    "dist/frontend",
    "src"
  ],
  "publishConfig": {
    "access": "public",
    "main": "./dist/frontend/src/index.js",
    "types": "./dist/frontend/src/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/frontend/src/index.d.ts",
        "import": "./dist/frontend/src/index.js"
      }
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@opendj/core": "workspace:*",
    "@opendj/realtime": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.7.0",
    "vitest": "^2.1.0"
  }
}
