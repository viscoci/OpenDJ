{
  "name": "@opendj/db",
  "version": "0.0.0",
  "description": "Drizzle schema, base migrations, and query helpers for OpenDJ.",
  "license": "MIT",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./schema": {
      "types": "./src/schema/index.ts",
      "import": "./src/schema/index.ts"
    },
    "./migrate": {
      "types": "./src/migrate.ts",
      "import": "./src/migrate.ts"
    }
  },
  "files": [
    "dist",
    "src",
    "migrations",
    "drizzle.config.ts"
  ],
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./schema": {
        "types": "./dist/schema/index.d.ts",
        "import": "./dist/schema/index.js"
      },
      "./migrate": {
        "types": "./dist/migrate.d.ts",
        "import": "./dist/migrate.js"
      }
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "db:generate": "cross-env NODE_OPTIONS=\"--import tsx\" drizzle-kit generate",
    "db:migrate": "tsx src/bin/migrate.ts"
  },
  "dependencies": {
    "@opendj/core": "workspace:*",
    "drizzle-orm": "^0.36.0",
    "postgres": "^3.4.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "cross-env": "^7.0.3",
    "drizzle-kit": "^0.30.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0"
  }
}
