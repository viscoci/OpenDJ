{
  "name": "@opendj/backend",
  "version": "0.0.0",
  "description": "Hono routes and services for OpenDJ, runnable from Node and Cloudflare Workers.",
  "license": "MIT",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@opendj/abuse": "workspace:*",
    "@opendj/auth": "workspace:*",
    "@opendj/core": "workspace:*",
    "@opendj/db": "workspace:*",
    "@opendj/lyrics": "workspace:*",
    "@opendj/realtime": "workspace:*",
    "@opendj/sync": "workspace:*",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.12.29",
    "valibot": "^0.42.0"
  },
  "optionalDependencies": {
    "argon2": "^0.44.0"
  },
  "devDependencies": {
    "argon2": "^0.44.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0"
  }
}
