{
  "name": "@opendj/backend",
  "version": "0.5.0",
  "description": "Hono routes and services for OpenDJ, runnable from Node and Cloudflare Workers.",
  "license": "MIT",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      }
    }
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.json",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@opendj/abuse": "workspace:*",
    "@opendj/auth": "workspace:*",
    "@opendj/core": "workspace:*",
    "@opendj/db": "workspace:*",
    "@opendj/lyrics": "workspace:*",
    "@opendj/realtime": "workspace:*",
    "@opendj/sync": "workspace:*",
    "drizzle-orm": "^0.36.0",
    "hono": "^4.6.0",
    "valibot": "^0.42.0"
  },
  "optionalDependencies": {
    "argon2": "^0.41.0"
  },
  "devDependencies": {
    "argon2": "^0.41.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/viscoci/OpenDJ.git",
    "directory": "packages/backend"
  }
}
